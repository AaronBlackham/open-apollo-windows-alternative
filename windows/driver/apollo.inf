AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_AggTwxIn2%,     Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_AggTwxIn2%,     Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_AggX8pVirt12%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_AggX8pVirt12%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_AggX8pVirt12%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_AggX8pVirt34%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_AggX8pVirt34%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_AggX8pVirt34%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_AggX8pVirt56%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_AggX8pVirt56%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_AggX8pVirt56%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_AggX8pVirt78%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_AggX8pVirt78%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_AggX8pVirt78%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_AggX8pSpdifIn%, Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_AggX8pSpdifIn%, Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_AggX8pSpdifIn%, Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_AggTwxVirt12%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_AggTwxVirt12%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_AggTwxVirt12%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_AggTwxVirt34%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_AggTwxVirt34%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_AggTwxVirt34%,  Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_AggTwxSpdifIn%, Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_AggTwxSpdifIn%, Apollo_Agg_Out_Interface
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_AggTwxSpdifIn%, Apollo_Agg_Out_Interface

; Outputs and inputs: normal endpoints. They CAN become the default; install.ps1 puts your previous
; defaults back. To forbid one as default for good (it then cannot be chosen by hand either),
; give it Apollo_NeverDefault_AddReg too.
[Apollo_Out_Interface]
AddReg = Apollo_Endpoint_AddReg

; Monitor mix in: the monitor-mix loopback. Never a sensible default microphone.
[Apollo_Mix_Interface]
AddReg = Apollo_Endpoint_AddReg, Apollo_NeverDefault_AddReg

[Apollo_Endpoint_AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Apollo.EndpointName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

; [G7] Combined outputs and inputs: "Monitor" (Windows audio to the "windows" routes of the combined
; configuration, Studio: the Twin X MON outputs, summed with the DAW there; its purpose is to be the
; default output, spec 6.7), every unit's output jack and input. Choosable as defaults.
[Apollo_Agg_Out_Interface]
AddReg = Apollo_Agg_Endpoint_AddReg

; [G7] Combined "Monitor mix" in: the monitor-mix loopback of the unit Windows plays to. Never a default.
[Apollo_Agg_Mix_Interface]
AddReg = Apollo_Agg_Endpoint_AddReg, Apollo_NeverDefault_AddReg

[Apollo_Agg_Endpoint_AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%ApolloAgg.EndpointName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

; FLOW_MASK_CAPTURE | FLOW_MASK_RENDER | ROLE_MASK_COMMUNICATION | ROLE_MASK_CONSOLE
[Apollo_NeverDefault_AddReg]
HKR,EP\0,%PKEY_AudioDevice_NeverSetAsDefaultEndpoint%,0x00010001,0x305

[Apollo_Install.NT.Services]
AddService = apollo, 0x00000002, Apollo_Service

[Apollo_Service]
DisplayName   = %Apollo.SvcDesc%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\apollo.sys

[Apollo_Install.NT.Wdf]
KmdfService = apollo, Apollo_WdfSection

[Apollo_WdfSection]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName      = "Avium"
ManufacturerName  = "Avium"
DiskName          = "Apollo open driver disk"
; [Endpoints] the device names Windows shows (in parentheses after every endpoint name, and in Device
; Manager). The driver sets the x8p's friendly name to "Apollo" while it hosts the combined set.
Apollo.DeviceDesc = "Apollo x8p"
ApolloTwinX.DeviceDesc = "Apollo Twin X"
Apollo.SvcDesc    = "Apollo open driver"
Apollo.EndpointName = "Apollo x8p"
ApolloTwinX.EndpointName = "Apollo Twin X"
ApolloAgg.EndpointName = "Apollo"

